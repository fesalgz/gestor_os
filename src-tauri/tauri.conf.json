{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestor_OS",
  "version": "3.0.0",
  "identifier": "com.salgatech.gestoros",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gestor OS",
        "width": 1200,
        "height": 800,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3NUNEREM3QzAxRjk0NjkKUldScGxCL0F4OTFjOXlsamhJOFdCS1FxVExtVDdvaTljYVBHQlVNLzVObUszNjhCKzh5VncvMHAK",
      "endpoints": [
        "https://github.com/fesalgz/gestor_os/releases/latest/download/latest.json"
      ]
    }
  }
}
