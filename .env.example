# ========================================================
# GESTOR OS - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha com seus dados
# ========================================================

# Chave Privada do Auto-Updater (Caminho absoluto ou conteúdo da chave)
TAURI_SIGNING_PRIVATE_KEY=""
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# Repositório GitHub oficial para publicação de releases
GITHUB_REPO="fesalgz/gestor_os"

# Senha padrão de primeiro acesso para o Painel do Sistema
DEFAULT_ADMIN_PASSWORD="admin"
